{
  "name": "vscode-ai-commit-gen",
  "displayName": "AI Commit Generator (Multi-Provider)",
  "description": "Generate detailed, clear commit messages using AI with multi-provider fallback",
  "version": "1.4.1",
  "icon": "icon.png",
  "publisher": "muhammadalifh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammadalifh/vscode-ai-commit"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "groq",
    "openrouter",
    "llama",
    "conventional-commits",
    "commit-message"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "menus": {
      "scm/title": [
        {
          "command": "aiCommit.generate",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "aiCommit.manageKeys",
          "group": "navigation@2",
          "when": "scmProvider == git"
        },
        {
          "command": "aiCommit.history",
          "group": "navigation@3",
          "when": "scmProvider == git"
        },
        {
          "command": "aiCommit.checkProviders",
          "group": "1_aicommit@1",
          "when": "scmProvider == git"
        }
      ]
    },
    "commands": [
      {
        "command": "aiCommit.generate",
        "title": "AI: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiCommit.manageKeys",
        "title": "AI: Manage API Keys",
        "icon": "$(key)"
      },
      {
        "command": "aiCommit.checkProviders",
        "title": "AI: Check Provider Status",
        "icon": "$(pulse)"
      },
      {
        "command": "aiCommit.history",
        "title": "AI: Commit History",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "aiCommit.generate",
        "key": "ctrl+shift+g ctrl+shift+m",
        "mac": "cmd+shift+g cmd+shift+m"
      },
      {
        "command": "aiCommit.manageKeys",
        "key": "ctrl+shift+g ctrl+shift+k",
        "mac": "cmd+shift+g cmd+shift+k"
      },
      {
        "command": "aiCommit.history",
        "key": "ctrl+shift+g ctrl+shift+h",
        "mac": "cmd+shift+g cmd+shift+h"
      }
    ],
    "configuration": [
      {
        "title": "AI Commit Generator",
        "properties": {
          "aiCommit.preferredProvider": {
            "type": "string",
            "enum": [
              "auto",
              "random",
              "groq",
              "openrouter",
              "mistral",
              "cohere"
            ],
            "enumDescriptions": [
              "Auto: Use providers in priority order (Groq → OpenRouter → Mistral → Cohere)",
              "Random: Shuffle available providers randomly",
              "Groq: Use Groq as primary provider",
              "OpenRouter: Use OpenRouter as primary provider",
              "Mistral: Use Mistral AI as primary provider",
              "Cohere: Use Cohere as primary provider"
            ],
            "default": "auto",
            "markdownDescription": "**Preferred AI Provider**\n\nSelect which AI provider to use first. Others will be used as fallback if the preferred one fails.",
            "order": 1
          },
          "aiCommit.commitStyle": {
            "type": "string",
            "enum": [
              "conventional",
              "detailed",
              "simple"
            ],
            "enumDescriptions": [
              "Conventional Commits format (feat:, fix:, docs:, etc.)",
              "Detailed multi-line commit with body explanation",
              "Simple one-line commit message"
            ],
            "default": "conventional",
            "markdownDescription": "**Commit Message Style**\n\nChoose the format for generated commit messages.",
            "order": 2
          },
          "aiCommit.language": {
            "type": "string",
            "enum": [
              "english",
              "indonesian"
            ],
            "default": "english",
            "markdownDescription": "**Language**\n\nLanguage for generated commit messages.",
            "order": 3
          },
          "aiCommit.outputMode": {
            "type": "string",
            "enum": [
              "scm",
              "clipboard",
              "editor"
            ],
            "enumDescriptions": [
              "Fill the Source Control input box (default)",
              "Copy commit message to clipboard",
              "Open commit message in a new editor tab for review/editing"
            ],
            "default": "scm",
            "markdownDescription": "**Output Mode**\n\nWhere to put the generated commit message.",
            "order": 4
          }
        }
      },
      {
        "title": "AI Commit Generator: Providers",
        "properties": {
          "aiCommit.groqModel": {
            "type": "string",
            "enum": [
              "llama-3.3-70b-versatile",
              "llama-3.1-70b-versatile",
              "llama-3.1-8b-instant",
              "gemma2-9b-it",
              "mixtral-8x7b-32768"
            ],
            "enumDescriptions": [
              "LLaMA 3.3 70B - Best quality (recommended)",
              "LLaMA 3.1 70B - High quality",
              "LLaMA 3.1 8B - Fastest response",
              "Gemma 2 9B - Google's open model",
              "Mixtral 8x7B - Good for code"
            ],
            "default": "llama-3.3-70b-versatile",
            "markdownDescription": "**Groq Model**\n\n✅ All Groq models are **FREE** with generous rate limits.\n\n🔑 [Manage API Keys → Key Manager](command:aiCommit.manageKeys)",
            "order": 11
          },
          "aiCommit.openrouterModel": {
            "type": "string",
            "enum": [
              "arcee-ai/trinity-large-preview:free",
              "arcee-ai/trinity-mini-preview:free"
            ],
            "enumDescriptions": [
              "Arcee Trinity Large - Best Free (detailed responses)",
              "Arcee Trinity Mini - Fast Free (2.8s latency)"
            ],
            "default": "arcee-ai/trinity-large-preview:free",
            "markdownDescription": "**OpenRouter Model**\n\n✅ Only showing verified **FREE** models.\n\n🔑 [Manage API Keys → Key Manager](command:aiCommit.manageKeys)",
            "order": 21
          },
          "aiCommit.mistralModel": {
            "type": "string",
            "enum": [
              "codestral-latest",
              "mistral-small-latest",
              "ministral-8b-latest",
              "open-mistral-nemo",
              "mistral-large-latest"
            ],
            "enumDescriptions": [
              "Codestral - Best for code (recommended, FREE)",
              "Mistral Small - Fast (78 tok/s)",
              "Ministral 8B - Lightweight (91.5 tok/s)",
              "Mistral Nemo - Open Source (78.6 tok/s)",
              "Mistral Large - Highest quality (PAID)"
            ],
            "default": "codestral-latest",
            "markdownDescription": "**Mistral Model**\n\n✅ `codestral-latest` is **FREE** for code tasks.\n\n🔑 [Manage API Keys → Key Manager](command:aiCommit.manageKeys)",
            "order": 31
          },
          "aiCommit.cohereModel": {
            "type": "string",
            "enum": [
              "command-r-plus-08-2024",
              "command-r-08-2024",
              "command-r7b-12-2024"
            ],
            "enumDescriptions": [
              "Command R+ - Best quality (53.6 tok/s)",
              "Command R - Balanced (59.9 tok/s)",
              "Command R 7B - Efficient (88.8 tok/s, fastest)"
            ],
            "default": "command-r-plus-08-2024",
            "markdownDescription": "**Cohere Model**\n\n✅ FREE tier: **1000 API calls/month**.\n\n🔑 [Manage API Keys → Key Manager](command:aiCommit.manageKeys)",
            "order": 41
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node ./out/test/runTest.js",
    "release": "bumpp --commit --push --tag"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "bumpp": "^10.4.0",
    "chai": "^6.2.2",
    "eslint": "^8.54.0",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
